#ifndef __3rd_party_libraries_MACRO_H
#define __3rd_party_libraries_MACRO_H

/// Enable Triangle
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_TRIANGLE

/// Enable Tetgen
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_TETGEN

/// Enable VTK
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_VTK

/// Enable MKL
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_MKL

/// Enable Metis
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_METIS

/// Enable VORO++
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_VORO

/// Enable SUITESPARSE
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_SUITESPARSE

/// Enable PETSc
/// - 0 false
/// - 1 true
#cmakedefine01 ENABLE_PETSC


// the configured options and settings for Tutorial
#define third_party_libraries_VERSION_MAJOR @third_party_libraries_VERSION_MAJOR@
#define third_party_libraries_VERSION_MINOR @third_party_libraries_VERSION_MINOR@

#endif
