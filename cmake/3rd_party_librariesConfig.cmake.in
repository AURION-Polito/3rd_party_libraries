# This file exports the 3rd_party_libraries::3rd_party_libraries CMake target which should be passed to the
# target_link_libraries command.

@PACKAGE_INIT@

if(NOT TARGET 3rd_party_libraries)
 	include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

check_required_components("@PROJECT_NAME@")

message(STATUS "Found 3rd_party_libraries version: ${3rd_party_libraries_VERSION}")
